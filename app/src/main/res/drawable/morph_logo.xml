<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!--
        Morph Logo — Ribbon M
        Two overlapping rounded-capsule ribbons forming the letter M.
        Left ribbon: purple (#7952E8 → #B58AFF)
        Right ribbon: pink  (#B58AFF → #EC83D3)
        Viewport: 100 × 100
    -->

    <!-- LEFT ribbon (purple-to-lavender): bottom-left → top-center -->
    <path
        android:pathData="
            M 20,80
            C 20,80 16,80 14,76
            C 12,72 12,68 12,68
            L 36,20
            C 36,20 38,16 42,14
            C 46,12 50,12 50,12
            C 50,12 54,12 56,16
            C 58,20 56,24 56,24
            L 32,72
            C 32,72 30,76 26,78
            C 23,80 20,80 20,80 Z"
        android:fillColor="#00000000"
        android:fillType="nonZero">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="14"
                android:startY="80"
                android:endX="56"
                android:endY="12"
                android:type="linear">
                <item android:offset="0" android:color="#FF7952E8"/>
                <item android:offset="1" android:color="#FFB58AFF"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- RIGHT ribbon (lavender-to-pink): bottom-right → top-center -->
    <path
        android:pathData="
            M 80,80
            C 80,80 77,80 74,78
            C 70,76 68,72 68,72
            L 44,24
            C 44,24 42,20 44,16
            C 46,12 50,12 50,12
            C 50,12 54,12 58,14
            C 62,16 64,20 64,20
            L 88,68
            C 88,68 88,72 86,76
            C 84,80 80,80 80,80 Z"
        android:fillColor="#00000000"
        android:fillType="nonZero">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44"
                android:startY="12"
                android:endX="88"
                android:endY="80"
                android:type="linear">
                <item android:offset="0" android:color="#FFB58AFF"/>
                <item android:offset="1" android:color="#FFEC83D3"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>
